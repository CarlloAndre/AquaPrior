@model AquaPrior.ViewModels.MapaCalorVM
@{
    ViewData["Title"] = "Mapa de reportes";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<section class="v">
<span class="eyebrow">PANORAMA TERRITORIAL</span>
<h1>Mapa de reportes</h1>
<p class="lead">Cada foco se centra entre los reportes cercanos del mismo incidente. Su área crece con la dispersión de los avisos y su color aumenta con las cuentas que lo corroboran.</p>
<div class="map-panel"><div id="mapa" role="region" aria-label="Mapa de calor de reportes de interrupción del agua"></div>
<div class="heat-legend"><span>Menos avisos</span><i style="background:linear-gradient(90deg,#a8ddb5,#f4d35e,#e76f51)"></i><span>Más avisos</span></div>
<p class="map-caption">Centro calculado con las ubicaciones registradas. Verde: hasta 3 cuentas; amarillo: de 4 a 6; rojo: 7 o más. El área representa los avisos y un margen visual de 40 metros. Se actualiza al recargar.</p></div>
@if (!Model.Distritos.Any(d => d.Incidentes > 0))
{
    <p class="hint">Aún no hay incidentes corroborados para mostrar.</p>
}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<div class="list">
@foreach (var distrito in Model.Distritos.Where(d => d.Incidentes > 0).OrderByDescending(d => d.Total))
{
    <div class="card"><b>@distrito.Nombre</b> · @distrito.Incidentes incidentes activos · @distrito.Total reportes corroborados</div>
}
</div>
<script>
    const focos = @Json.Serialize(Model.Puntos);
    const mapa = L.map('mapa').setView([-8.08, -79.0], 12);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18, attribution: '&copy; OpenStreetMap'
    }).addTo(mapa);
    const limites = L.latLngBounds([]);
    focos.forEach(f => {
        const color = f.intensidad < 0.4 ? '#32b56c' : f.intensidad < 0.7 ? '#f5c542' : '#e74732';
        // Los focos cercanos se superponen y forman una sola mancha de calor.
        for (let anillo = 10; anillo >= 1; anillo--) {
            const circulo = L.circle([f.lat, f.lng], {
                radius: f.radioMetros * anillo / 10,
                stroke: false, fillColor: color, fillOpacity: 0.08, interactive: false
            }).addTo(mapa);
            if (anillo === 10) limites.extend(circulo.getBounds());
        }
        const detalle = document.createElement('div');
        detalle.textContent = f.direccion + ' · ' + f.reportes + ' reportes corroborados · ' + f.tipo;
        L.circle([f.lat, f.lng], {
            radius: f.radioMetros, stroke: false, fillOpacity: 0, opacity: 0
        }).addTo(mapa).bindPopup(detalle);
    });
    if (limites.isValid()) mapa.fitBounds(limites, { padding: [40, 40], maxZoom: 16 });
</script>
</section>
