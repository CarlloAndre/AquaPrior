@model RegistroVM
@{ ViewData["Title"] = "Crear cuenta"; }
<section class="v">
    <div class="auth-layout"><div class="auth-intro"><span class="eyebrow">AQUAPRIOR · TRUJILLO</span><h1>Tu comunidad empieza contigo.</h1><p class="lead">Crea tu cuenta de ciudadano y comparte información sobre los cortes de agua de tu distrito.</p><div class="auth-detail"><b>Reportar es el primer paso.</b>Los reportes pasan por una revisión administrativa antes de participar en la priorización.</div></div><div>
    <form class="card" asp-action="Registro" method="post" novalidate>
        <label>Nombre
            <input asp-for="Nombre" autocomplete="name" />
            <span asp-validation-for="Nombre" class="err"></span>
        </label>
        <label>Correo
            <input asp-for="Correo" autocomplete="email" />
            <span asp-validation-for="Correo" class="err"></span>
        </label>
        <label>Contraseña (mínimo 8 caracteres)
            <input asp-for="Clave" autocomplete="new-password" />
            <span asp-validation-for="Clave" class="err"></span>
        </label>
        <button class="btn" type="submit">Crear cuenta</button>
        <p class="hint">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a>.</p>
    </form>
    </div></div>
</section>
