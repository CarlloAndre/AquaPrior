@model Estadisticas
@{
    ViewData["Title"] = "Estadísticas";
    int maxZona = Model.PorZona.Any() ? Model.PorZona.Max(c => c.Cantidad) : 1;
    int Pct(int v, int m) => m == 0 ? 0 : (int)Math.Round(100.0 * v / m);
}
<section class="v">
    <h1>Estadísticas</h1>
    <p class="lead">Resumen calculado con los reportes registrados.</p>
    <div class="grid2">
        <div class="card"><div class="kpi">@Model.Total</div>reportes registrados</div>
        <div class="card"><div class="kpi">@Model.PorcentajeVerificados %</div>verificados · duración promedio @Formato.Horas(Model.PromedioHoras)</div>
    </div>
    <div class="grid2">
        <div class="card">
            <h2>Por estado</h2>
            <div class="bars">
                @foreach (var c in Model.PorEstado)
                {
                    <div class="bar-r"><span>@c.Etiqueta</span><div class="bar-t"><i style="width:@(Pct(c.Cantidad, Model.Total))%"></i></div><b>@c.Cantidad</b></div>
                }
            </div>
        </div>
        <div class="card">
            <h2>Por distrito</h2>
            <div class="bars">
                @foreach (var c in Model.PorZona)
                {
                    <div class="bar-r"><span>@c.Etiqueta</span><div class="bar-t"><i style="width:@(Pct(c.Cantidad, maxZona))%"></i></div><b>@c.Cantidad</b></div>
                }
            </div>
        </div>
    </div>
</section>
